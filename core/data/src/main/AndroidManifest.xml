<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Custom permission for token balance updates -->
    <permission 
        android:name="org.ethereumphone.walletmanager.permission.UPDATE_TOKEN_BALANCE"
        android:protectionLevel="signature" />
    
    <uses-permission android:name="org.ethereumphone.walletmanager.permission.UPDATE_TOKEN_BALANCE" />
    
    <application>
        <!-- BroadcastReceiver for token balance updates from TokenLauncher -->
        <!-- TODO: Re-enable permission check after testing -->
        <receiver
            android:name=".broadcast.TokenBalanceUpdateReceiver"
            android:exported="true">
            <!-- android:permission="org.ethereumphone.walletmanager.permission.UPDATE_TOKEN_BALANCE" -->
            <intent-filter>
                <action android:name="org.ethereumphone.walletmanager.DEDUCT_TOKEN_BALANCE" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver for low paymaster balance notifications from the system -->
        <receiver
            android:name=".broadcast.LowBalanceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.ethereumphone.walletmanager.ACTION_SHOW_LOW_BALANCE" />
            </intent-filter>
        </receiver>
        
        <!-- Content Provider for Swap Quotes -->
        <provider
            android:name=".provider.SwapQuoteContentProvider"
            android:authorities="com.walletmanager.swapquote.provider"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true" />
        
        <!-- Content Provider for Swap Transaction Data -->
        <provider
            android:name=".provider.SwapDataContentProvider"
            android:authorities="com.walletmanager.swapdata.provider"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- Content Provider for triggering price sync from external apps -->
        <provider
            android:name=".provider.PriceSyncContentProvider"
            android:authorities="com.walletmanager.pricesync.provider"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>