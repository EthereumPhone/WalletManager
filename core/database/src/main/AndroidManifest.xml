<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.core.database">

    <application>
        <!-- Content Provider for Token Balance -->
        <provider
            android:name=".provider.TokenBalanceContentProvider"
            android:authorities="${applicationId}.tokenbalance.provider"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true"
            android:writePermission="${applicationId}.permission.UPDATE_TOKEN_BALANCE" />

        <!-- Content Provider for Token Metadata -->
        <provider
            android:name=".provider.TokenMetadataContentProvider"
            android:authorities="${applicationId}.tokenmetadata.provider"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true" /> 
    </application>

</manifest>